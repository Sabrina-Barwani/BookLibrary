@model List<Category>

<div>
    <div class="flex">
        <h1 class="text-primary">Category</h1>
        <button type="button" class="btn">Add Category</button>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Category Name</th>
                    <th>Options</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td>@obj.Id</td>
                        <td>@obj.Name</td>
                        <td>
                            <a href="#"> <button type="button" class="btn">Edit</button></a>
                            <a href="#"> <button type="button" class="btn">Delete</button></a>
                            <a href="@Url.Action("BooksByCategory", "Category", new { id = obj.Id })" class="btn">Display</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
